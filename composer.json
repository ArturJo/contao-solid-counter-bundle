{
  "name": "solidwork/contao-solid-counter-bundle",
  "description": "Animated count-up counter content element for contao 5.3 (controller-based).",
  "type": "contao-bundle",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.3"
  },
  "autoload": {
    "psr-4": {
      "Solidwork\\ContaoSolidCounterBundle\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "Solidwork\\ContaoSolidCounterBundle\\ContaoManager\\Plugin"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
